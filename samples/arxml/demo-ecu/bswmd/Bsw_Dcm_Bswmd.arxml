<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-4.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Dcm</SHORT-NAME>
      <ELEMENTS>
        <ECUC-MODULE-DEF>
          <SHORT-NAME>Dcm</SHORT-NAME>
          <DESC>Demo-ecu Dcm module definition (v1.27.0 ship fixture). Container shortNames match canonical AUTOSAR (DcmDsp* prefix per the claude-autosarcfg-canonical-autosar-pdur-paths-not-tables lesson). The xlsx sheet names (DcmClearDTC / DcmReadDTC / DcmReadDataById / DcmWriteDataById / DcmRoutineControl) are abstracted; the SHEET_TO_CONTAINER_SHORT_NAME seam in src/core/bridge/xlsxDcmServicesToEcucBatch.ts maps them to these canonical container shortNames.</DESC>
          <CONTAINERS>
            <ECUC-PARAM-CONF-CONTAINER-DEF>
              <SHORT-NAME>DcmDspClearDTC</SHORT-NAME>
              <DESC>Canonical AUTOSAR container for UDS service 0x14 (Clear Diagnostic Information). Referenced by xlsx sheet 'DcmClearDTC'.</DESC>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF>
              <SHORT-NAME>DcmDspReadDTCInformation</SHORT-NAME>
              <DESC>Canonical AUTOSAR container for UDS service 0x19 (ReadDTCInformation). Referenced by xlsx sheet 'DcmReadDTC'.</DESC>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF>
              <SHORT-NAME>DcmDspDid</SHORT-NAME>
              <DESC>Canonical AUTOSAR parent container for UDS services 0x22 (ReadDataById) and 0x2E (WriteDataById). The mapper differentiates via per-row definitionRef emitted in PatchSteps. Referenced by xlsx sheets 'DcmReadDataById' and 'DcmWriteDataById'.</DESC>
              <REFERENCES>
                <ECUC-REFERENCE-DEF>
                  <SHORT-NAME>didRef</SHORT-NAME>
                  <DESC>Reference to the ODX-extracted DCM-DSP-DID data instance this service reads from.</DESC>
                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <REFERENCE-VALUES>
                    <ECUC-REFERENCE-VALUE DEST="DCM-DSP-DID">/Dcm/DcmDspDid</ECUC-REFERENCE-VALUE>
                  </REFERENCE-VALUES>
                </ECUC-REFERENCE-DEF>
              </REFERENCES>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
            <ECUC-PARAM-CONF-CONTAINER-DEF>
              <SHORT-NAME>DcmDspRoutine</SHORT-NAME>
              <DESC>Canonical AUTOSAR container for UDS service 0x31 (RoutineControl). Referenced by xlsx sheet 'DcmRoutineControl'.</DESC>
              <REFERENCES>
                <ECUC-REFERENCE-DEF>
                  <SHORT-NAME>routineRef</SHORT-NAME>
                  <DESC>Reference to the ODX-extracted DCM-DSP-ROUTINE data instance this service controls.</DESC>
                  <LOWER-MULTIPLICITY>0</LOWER-MULTIPLICITY>
                  <UPPER-MULTIPLICITY>1</UPPER-MULTIPLICITY>
                  <REFERENCE-VALUES>
                    <ECUC-REFERENCE-VALUE DEST="DCM-DSP-ROUTINE">/Dcm/DcmDspRoutine</ECUC-REFERENCE-VALUE>
                  </REFERENCE-VALUES>
                </ECUC-REFERENCE-DEF>
              </REFERENCES>
            </ECUC-PARAM-CONF-CONTAINER-DEF>
          </CONTAINERS>
        </ECUC-MODULE-DEF>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>