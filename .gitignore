# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
out/
release/
*.tsbuildinfo

# Test output
coverage/
playwright-report/
test-results/
.nyc_output/

# ARXML round-trip fixtures (5 user BSW samples from S32K148_EAS_EB_3399A).
# Sprint 0-1 kept them gitignored because parser/serializer unit tests hit
# the 80% coverage gate on their own. Sprint 2 adds 5-sample mutation
# round-trip (T7) which depends on these, so they are now in-repo.

# Local reference ARXML (not shipped templates).
# `samples/arxml/<id>/` is the convention for shipped templates (see samples/README.md).
# Flat `AUTOSAR_MOD_*.arxml` here is the full AUTOSAR R21-11 standard ECUC parameter
# definition (~15 MB) — kept as a local reference fixture, not shipped via electron-builder.
samples/arxml/AUTOSAR_MOD_*.arxml

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Electron
dist-electron/

# OS
desktop.ini
$RECYCLE.BIN/

# Local regeneration scripts (one-off per project, not part of repo)
# e.g. claude-AutosarCfg/regenerate.ts is a personal script with hard-coded
# absolute paths to user ECUC fixtures, not a repo-shipped tool.
claude-AutosarCfg/

# Sibling worktree directories (project-local convention; created via
# `git worktree add ../claude-AutosarCfg-v<version>-<type>/ -b feature/v<version>-<type>`).
# Examples: claude-AutosarCfg-v1-14-2-patch/, claude-AutosarCfg-v1-15-0-minor/
claude-AutosarCfg-v*/

# One-off personal helper scripts in scripts/ (e.g. tmp-write-topic.py
# 2026-07-10 hard-coded absolute paths to local vault + non-repo source
# file; used once to write a single topic file, then deleted). Convention:
# any script matching `scripts/tmp-*.py` is local scratch, not part of the
# shipped repo.
scripts/tmp-*.py

# Python bytecode caches (__pycache__/ directories and .pyc files). Created
# automatically by Python's import system whenever any .py file is imported.
# Per v1.45.0 PATCH: closes v1.44.1 honest deviation (a) -- before this
# rule, importing scripts/validate_hook_range.py created an untracked
# __pycache__/ that interfered with `git status` cleanliness.
**/__pycache__/
*.pyc
*.pyo

# Local Claude Code scratch space (spec-driven dev session reports + reviews).
# Kept on disk for the active session; never committed.
.claude/